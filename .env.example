# Copy to .env.local and fill in values. Never commit .env.local.

# Canonical URL for Open Graph / metadata (production: https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (browser + server; RLS enforced with user session)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI: MVP defaults to Groq + Llama 3.1 8B Instant. Set AI_PROVIDER to openai | anthropic to switch.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional — if 8B outputs feel too generic, try: GROQ_MODEL=llama-3.3-70b-versatile
# (see src/lib/ai/providers/groq.ts for GROQ_OPTIONAL_QUALITY_MODEL)

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Not read by this app's source code (no server-only admin routes yet).
# If you add scripts or admin APIs, use these server-side only—never NEXT_PUBLIC_*.
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
